<t name="Postres" t-name="ebal_chicharito.postres">
    <t t-call="website.layout">
        <div id="wrap" class="oe_structure oe_empty chi-sweetpage">


<section class="chi-sweet-hero" data-name="Portada postres"><div class="chi-wrap chi-split">
  <div>
    <span class="chi-eyebrow" style="background:#fff;color:#e0457b">hechos con cariño</span>
    <h1 class="mt-2">Postrecitos</h1>
    <p>Ingredientes de calidad, hechos a mano con amor. Cuchareables, cheesecakes, tortas, galletas, colada morada y guaguas de pan.</p>
    <a href="#pedido" class="chi-btn chi-btn-pink chi-open-cart">🛒 Hacer mi pedido</a>
  </div>
  <img class="chi-mom" src="{{img:mama.webp}}" alt="Postres hechos a mano" loading="lazy"/>
</div></section>
<section data-name="Postres" id="pedido"><div class="chi-wrap"><div class="chi-sgrid"><div class="chi-sw"><div class="chi-sprice">$3,50</div><img src="{{img:cuchareable_redvelvet.webp}}" alt="Cuchareable de red velvet" loading="lazy"/><h3>Cuchareable de red velvet</h3><button type="button" class="chi-add chi-add-pink" data-name="Cuchareable de red velvet" data-price="3.50">+ Agregar</button></div><div class="chi-sw"><div class="chi-sprice">$3,50</div><img src="{{img:cuchareable_chocolate.webp}}" alt="Cuchareable de chocolate" loading="lazy"/><h3>Cuchareable de chocolate</h3><button type="button" class="chi-add chi-add-pink" data-name="Cuchareable de chocolate" data-price="3.50">+ Agregar</button></div><div class="chi-sw"><img src="{{img:cheesecake.webp}}" alt="Cheesecake de fresa" loading="lazy"/><h3>Cheesecake de fresa</h3><span class="chi-pill">Porción</span><button type="button" class="chi-add chi-add-pink" data-name="Cheesecake de fresa (porción)" data-price="0">+ Agregar</button></div><div class="chi-sw"><img src="{{img:cheesecake_entero.webp}}" alt="Cheesecake de fresa" loading="lazy"/><h3>Cheesecake de fresa</h3><span class="chi-pill big">Entero</span><button type="button" class="chi-add chi-add-pink" data-name="Cheesecake de fresa (entero)" data-price="0">+ Agregar</button></div><div class="chi-sw"><img src="{{img:torta_chocolate.webp}}" alt="Torta de chocolate" loading="lazy"/><h3>Torta de chocolate</h3><span class="chi-pill">Porción</span><button type="button" class="chi-add chi-add-pink" data-name="Torta de chocolate (porción)" data-price="0">+ Agregar</button></div><div class="chi-sw"><img src="{{img:torta_chocolate_entera.webp}}" alt="Torta de chocolate" loading="lazy"/><h3>Torta de chocolate</h3><span class="chi-pill big">Entera</span><button type="button" class="chi-add chi-add-pink" data-name="Torta de chocolate (entera)" data-price="0">+ Agregar</button></div><div class="chi-sw"><img src="{{img:red_velvet.webp}}" alt="Red velvet" loading="lazy"/><h3>Red velvet</h3><span class="chi-pill">Porción</span><button type="button" class="chi-add chi-add-pink" data-name="Red velvet (porción)" data-price="0">+ Agregar</button></div><div class="chi-sw"><img src="{{img:red_velvet_entera.webp}}" alt="Red velvet" loading="lazy"/><h3>Red velvet</h3><span class="chi-pill big">Entera</span><button type="button" class="chi-add chi-add-pink" data-name="Red velvet (entera)" data-price="0">+ Agregar</button></div><div class="chi-sw"><img src="{{img:galletas.webp}}" alt="Galletas" loading="lazy"/><h3>Galletas</h3><button type="button" class="chi-add chi-add-pink" data-name="Galletas" data-price="0">+ Agregar</button></div><div class="chi-sw"><img src="{{img:colada_morada.webp}}" alt="Colada morada" loading="lazy"/><h3>Colada morada</h3><button type="button" class="chi-add chi-add-pink" data-name="Colada morada" data-price="0">+ Agregar</button></div><div class="chi-sw"><img src="{{img:guaguas.webp}}" alt="Guaguas de pan" loading="lazy"/><h3>Guaguas de pan</h3><button type="button" class="chi-add chi-add-pink" data-name="Guaguas de pan" data-price="0">+ Agregar</button></div></div></div></section>
<section class="chi-ask" data-name="Pedir"><div class="chi-wrap">
  <p class="chi-script" style="font-size:1.8rem">¿Se te antojó algo?</p>
  <p class="fw-bold">Agrega tus postres y envía el pedido por WhatsApp. Te confirmamos el precio y la entrega.</p>
  <a href="#pedido" class="chi-btn chi-btn-pink chi-open-cart">🛒 Ver mi pedido</a>
</div></section>
        </div>
    </t>
</t>
