<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Más margen superior en la orden de trabajo y la proforma.
         report.paperformat.margin_top / header_spacing son enteros (mm):
         2 -> 3 mm (el valor entero más cercano a +25%). -->
    <record id="ebal_mechanic.paperformat_workorder" model="report.paperformat">
        <field name="margin_top">3</field>
        <field name="header_spacing">3</field>
    </record>
    <record id="ebal_mechanic.paperformat_quotation" model="report.paperformat">
        <field name="margin_top">3</field>
        <field name="header_spacing">3</field>
    </record>

    <!-- ================= ORDEN DE TRABAJO ================= -->
    <template id="report_workorder_document_madbike"
              inherit_id="ebal_mechanic.report_workorder_document"
              priority="99">

        <!-- +15% al tamaño de letra general (escala todo el documento) -->
        <xpath expr="//div[hasclass('article')]" position="attributes">
            <attribute name="style">zoom: 1.15;</attribute>
        </xpath>

        <!-- +10% de espacio para firmar (arriba de la tabla de firmas) -->
        <xpath expr="//table[contains(@style, 'margin-top:30px')]" position="before">
            <div style="height:77px;"/>
        </xpath>

        <!-- Pie de página, después de las firmas. Letra de la cuenta +50%. -->
        <xpath expr="//table[contains(@style, 'margin-top:30px')]" position="after">
            <div style="margin-top:28px; text-align:center; font-size:18pt; font-weight:bold; color:#0b2474; line-height:1.5;">
                <div>El trabajo se realizará con el 50% del anticipo</div>
                <div>Cta Jep: 406189332900</div>
            </div>
        </xpath>

        <!-- Un poco más de separación entre el bloque de autorización y las firmas -->
        <xpath expr="//table[contains(@style, 'margin-top:30px')]" position="attributes">
            <attribute name="style">width:100%; margin-top:66px; text-align:center; font-size:18pt;</attribute>
        </xpath>
    </template>

    <!-- ================= PROFORMA (plantilla no-RIDE, por si está activa) = -->
    <template id="report_quotation_document_madbike"
              inherit_id="ebal_mechanic.report_quotation_document"
              priority="99">

        <xpath expr="//div[hasclass('article')]" position="attributes">
            <attribute name="style">zoom: 1.15;</attribute>
        </xpath>

        <xpath expr="//table[contains(@style, 'margin-top:30px')]" position="before">
            <div style="height:77px;"/>
        </xpath>
        <xpath expr="//table[contains(@style, 'margin-top:30px')]" position="after">
            <div style="margin-top:28px; text-align:center; font-size:18pt; font-weight:bold; color:#0b2474; line-height:1.5;">
                <div>El trabajo se realizará con el 50% del anticipo</div>
                <div>Cta Jep: 406189332900</div>
            </div>
        </xpath>
        <xpath expr="//table[contains(@style, 'margin-top:30px')]" position="attributes">
            <attribute name="style">width:100%; margin-top:66px; text-align:center; font-size:18pt;</attribute>
        </xpath>
    </template>

    <!-- ================= PROFORMA (RIDE) ================= -->
    <template id="report_quotation_document_ec_ride_madbike"
              inherit_id="ebal_mechanic.report_quotation_document_ec_ride"
              priority="99">

        <!-- +15% al tamaño de letra general -->
        <xpath expr="//div[hasclass('article')]" position="attributes">
            <attribute name="style">zoom: 1.15;</attribute>
        </xpath>

        <!-- +10% de espacio para firmar (arriba del bloque de firmas) -->
        <xpath expr="//div[hasclass('row') and hasclass('mt-4')]" position="before">
            <div style="height:61px;"/>
        </xpath>

        <!-- Pie de página, después de las firmas. Letra de la cuenta +50%. -->
        <xpath expr="//div[hasclass('row') and hasclass('mt-4')]" position="after">
            <div class="mt-3 text-center" style="font-size:15px; font-weight:bold; line-height:1.6;">
                <div>El trabajo se realizará con el 50% del anticipo</div>
                <div>Cta Jep: 406189332900</div>
            </div>
        </xpath>
    </template>

</odoo>
