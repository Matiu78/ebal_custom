<t name="{{B_NAME}}" t-name="ebal_madbike.{{B_KEY}}_page">
    <t t-call="website.layout">
        <t t-set="pageName" t-value="'{{B_KEY}}'"/>
        <div id="wrap" class="oe_structure oe_empty mb mb-brand-page mb-b-{{B_KEY}}">
<section class="mb-brand-hero" data-name="{{B_NAME}}">
    <div class="mb-wrap">
        <h1 class="mb-h">{{B_TITLE}}</h1>
        <p>{{B_INTRO}}</p>
    </div>
</section>
<section class="mb-sec" data-name="Productos {{B_NAME}}">
    <div class="mb-wrap">
        <div class="mb-brand-subs">
            <a href="/shop/category/{{B_SLUG}}">Todo {{B_NAME}}</a>
{{B_SUBS}}
        </div>
        <t t-set="items" t-value="request.env['product.template'].search([('is_published','=',True),('public_categ_ids','child_of',{{B_ID}})], order='website_sequence, id desc', limit=60)"/>
        <t t-set="prices" t-value="items._get_sales_prices(website)"/>
        <div class="mb-cards" t-if="items">
            <t t-foreach="items" t-as="p">
                <a class="mb-card" t-att-href="p.website_url">
                    <span t-attf-class="mb-card-img #{'' if p.image_128 else 'mb-noimg'}">
                        <img t-if="p.image_128" t-att-src="website.image_url(p, 'image_512')" t-att-alt="p.name" loading="lazy"/>
                        <img t-else="" src="{{img:logo_madbike.png}}" alt="" loading="lazy"/>
                    </span>
                    <span class="mb-card-body">
                        <span class="mb-card-code" t-out="p.default_code or ''"/>
                        <span class="mb-card-name" t-out="p.name"/>
                        <span class="mb-card-price" t-if="p.list_price" t-out="prices.get(p.id, {}).get('price_reduce', p.list_price)" t-options="{'widget': 'monetary', 'display_currency': website.currency_id}"/>
                        <span class="mb-card-price mb-ask" t-else="">Consultar precio</span>
                    </span>
                </a>
            </t>
        </div>
        <t t-set="total_items" t-value="request.env['product.template'].search_count([('is_published','=',True),('public_categ_ids','child_of',{{B_ID}})])"/>
        <p class="mt-4 text-center" t-if="items and total_items &gt; len(items)">
            <a class="mb-btn mb-btn-dark" href="/shop/category/{{B_SLUG}}">Ver todos los productos {{B_NAME}} (<t t-out="total_items"/>)</a>
        </p>
        <div class="mb-empty" t-else="">Estamos cargando el catálogo {{B_NAME}}. Escríbenos por <a href="{{WA}}" target="_blank">WhatsApp</a> y te decimos qué hay disponible.</div>
    </div>
</section>
        </div>
    </t>
</t>
