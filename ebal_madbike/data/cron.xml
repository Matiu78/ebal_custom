<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="cron_gala_sync" model="ir.cron">
        <field name="name">Gala: sincronizar precios y disponibilidad</field>
        <field name="model_id" ref="model_ebal_gala_sync"/>
        <field name="state">code</field>
        <field name="code">model.run_sync()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="nextcall" eval="(DateTime.now() + timedelta(days=1)).replace(hour=8, minute=30, second=0)"/>
    </record>
</odoo>
